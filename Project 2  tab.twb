      <aliases enabled='yes' />
      <column caption='Time Field-Hour' datatype='integer' name='[Calculation_1338695918297088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[Date])' />
      </column>
      <column caption='Time Field Week' datatype='string' name='[Calculation_1338695918567425]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[Date])' />
      </column>
      <column caption='Time Block' datatype='string' name='[Calculation_1338695919337475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[Date]) &gt;= 6 AND DATEPART(&apos;hour&apos;,[Date]) &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[Date]) &gt;= 12 AND DATEPART(&apos;hour&apos;,[Date]) &lt; 17 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[Date]) &gt;= 17 AND DATEPART(&apos;hour&apos;,[Date]) &lt; 21 THEN &quot;Evening&quot;&#13;&#10;ELSE &quot;Night&quot;&#13;&#10;END' />
      </column>
      <column caption='Arrest Status' datatype='string' name='[Calculation_1338695919669252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Arrest] = TRUE THEN &quot;Arrest Made&quot;&#13;&#10;ELSE &quot;No Arrest&quot;&#13;&#10;END' />
      </column>
      <column caption='Severe Crime Flag' datatype='string' name='[Calculation_1338695919910917]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Primary Type] IN (&quot;HOMICIDE&quot;,&quot;ROBBERY&quot;,&quot;ASSAULT&quot;,&quot;CRIM SEXUAL ASSAULT&quot;)&#13;&#10;THEN &quot;Severe&quot;&#13;&#10;ELSE &quot;Non-Severe&quot;&#13;&#10;END' />
      </column>
      <column caption='Domestic %' datatype='real' name='[Calculation_1338695952642054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Domestic] = TRUE THEN 1 ELSE 0 END) &#13;&#10;/ COUNT([ID])' />
      </column>
      <column caption='Hour of day' datatype='integer' name='[Calculation_1338695955914759]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;,[Date])' />
      </column>
